#
# GENERATED by scripts/grade-receipt.sh — do not hand-edit.
# Regenerate: bash scripts/grade-receipt.sh --write   Check: --check
#
# A verification receipt in the sense of mathesis
# estate-mathematical-architecture §6: it names the exact gate, the exact
# pin and the exact commit the result belongs to.  It is not a proof and it
# does not substitute for the CI log.

[identity]
project = "secret-types"
name = "agda-grade3 verification receipt"
repository = "hyperpolymath/secret-types"
uuid = "462660d5-8b7e-5bfb-a72c-a942273aa064"
uuid-source = "uuid5(URL, github.com/hyperpolymath/secret-types)"
uuid-note = "CLADE.a2ml still carries the RSR template uuid — finding F-1, open"
kind = "theory"
source-commit = "8e421ccaec50"

[prover]
tool = "agda"
version = "2.6.4.3"
provenance = "Debian 13 agda-bin=2.6.4.3-1+b2"
library = "none (--no-libraries; Agda builtins only)"
flags = "--safe --without-K --no-libraries --ignore-interfaces --double-check -W error"
flags-source = "scripts/proof-flags.sh"
flags-note = "one definition, read by the gate and by this receipt; the receipt cannot describe a gate that did not run"

[conformance]
policy = "standards/3-practice/PROOF-POLICY.adoc"
policy-revision = "owner ruling 2026-10-26; section 2.1 dated 2026-11-01"
canonical-invocation = "agda --safe --without-K --cubical-compatible"
cubical-compatible = "waived"
waiver-ref = "docs/proof-debt.adoc#waivers"
waiver-reason = "every clause matching on the order relation is an indexed match, which Cubical Agda does not support; suppressing -WUnsupportedIndexedMatch would be a green gate over a weakened check"
stronger-than-canonical = ["--no-libraries", "--ignore-interfaces", "--double-check", "-W error"]

[gate]
command = "bash scripts/check.sh"
laws-certificate = "bash scripts/minimal-laws.sh"
ci = ".github/workflows/proofs.yml"
module-count = 14
reject-fixture-count = 3

[trust-base]
postulates = 0
escape-hatches = 0
library-dependencies = 0
axioms-assumed = 0
note = "a non-zero count above fails the gate; the receipt is only meaningful while all four are zero"

[[claims]]
# id | ledger token | mathesis grade | coq-leg | lean-leg
# mathesis grades theorems.  A refusal fixture or a witness of a leak is a
# checked demonstration, not a theorem, so it is below-grade-3 rather than
# graded — the token still says exactly how strongly it is checked.
# Legs are unavailable for every proven row: no Agda→Dedukti transport has
# been attempted from this repository and no hand re-proof exists.  Per
# PROOF-POLICY §2.3 that keeps each row at Grade 3 and no higher; see
# PROOF-STATUS.adoc "Grade and the independent-witness legs".
claim = { id = "N-1", token = "proven", grade = "grade-3", coq-leg = "unavailable", lean-leg = "unavailable" }
claim = { id = "N-2", token = "proven", grade = "grade-3", coq-leg = "unavailable", lean-leg = "unavailable" }
claim = { id = "N-3", token = "proven", grade = "grade-3", coq-leg = "unavailable", lean-leg = "unavailable" }
claim = { id = "N-4", token = "tested-only", grade = "below-grade-3", coq-leg = "n/a", lean-leg = "n/a" }
claim = { id = "N-5", token = "tested-only", grade = "below-grade-3", coq-leg = "n/a", lean-leg = "n/a" }
claim = { id = "N-6", token = "tested-only", grade = "below-grade-3", coq-leg = "n/a", lean-leg = "n/a" }
claim = { id = "N-7", token = "proven", grade = "grade-3", coq-leg = "unavailable", lean-leg = "unavailable" }
claim = { id = "N-8", token = "proven", grade = "grade-3", coq-leg = "unavailable", lean-leg = "unavailable" }

